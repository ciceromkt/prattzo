{
  "name": "pede-esse",
  "private": true,
  "version": "0.1.0",
  "description": "Cardápio digital com vídeo vertical e pedido montado pelo cliente, para restaurantes e bares",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:cardapio": "npm run dev -w @pede-esse/cardapio",
    "dev:painel": "npm run dev -w @pede-esse/painel",
    "build": "npm run build -w @pede-esse/cardapio && npm run build -w @pede-esse/painel",
    "test": "npm run test -w @pede-esse/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
