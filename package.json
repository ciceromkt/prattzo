{
  "name": "prattzo",
  "private": true,
  "version": "0.1.0",
  "description": "Cardápio digital com vídeo vertical e pedido montado pelo cliente, para restaurantes e bares",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:cardapio": "npm run dev -w @prattzo/cardapio",
    "dev:painel": "npm run dev -w @prattzo/painel",
    "build": "npm run build -w @prattzo/cardapio && npm run build -w @prattzo/painel",
    "test": "npm run test -w @prattzo/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
